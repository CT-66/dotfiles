{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Python",
            "type": "shell",
            "command": "python3",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "g++ \"${file}\" && ./a.out",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false,
                "echo": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run C",
            "type": "shell",
            "command": "gcc \"${file}\" && ./a.out",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false,
                "echo": false
            },
            "problemMatcher": []
        }
    ]
}
